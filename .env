# Configuración de Django
# DJANGO_SECRET_KEY="tu-clave-secreta-muy-larga-y-segura-aqui"
DJANGO_SECRET_KEY=django-insecure-key

# DJANGO_DEBUG="0" para producción, "1" para desarrollo
DJANGO_DEBUG=1

# Configuración de PostgreSQL
# POSTGRES_DB="sistema_usuarios_db"
POSTGRES_DB=users_db

# POSTGRES_USER="admin_usuarios"
POSTGRES_USER=users_user

# POSTGRES_PASSWORD="contraseña_segura_para_db_2026"
POSTGRES_PASSWORD=users_pass

# POSTGRES_HOST="users_db" (nombre del contenedor)
POSTGRES_HOST=db

# POSTGRES_PORT="5432" (puerto estándar de PostgreSQL)
POSTGRES_PORT=5432

# Configuración de pgAdmin (interfaz web para PostgreSQL)
# PGADMIN_DEFAULT_EMAIL="admin@sistema-usuarios.com"
PGADMIN_DEFAULT_EMAIL=admin@sistema-usuarios.com

# PGADMIN_DEFAULT_PASSWORD="admin123_seguro_2026"
PGADMIN_DEFAULT_PASSWORD=admin123_seguro_2026

# PGADMIN_LISTEN_PORT="80" (puerto interno del contenedor)
PGADMIN_LISTEN_PORT=80
