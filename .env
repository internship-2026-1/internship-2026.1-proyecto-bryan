POSTGRES_PASSWORD=users_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# (c) Core Service Database Configuration
CORE_POSTGRES_DB=core_db

# (multi-db) MongoDB Configuration para Catálogo de Productos
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=core_catalog

# Configuración de pgAdmin
