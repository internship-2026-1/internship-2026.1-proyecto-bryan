# LOCAL - PostgreSQL
POSTGRES_DB=core_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
CORE_POSTGRES_DB=core_db
CORE_POSTGRES_USER=postgres
CORE_POSTGRES_PASSWORD=postgres

# LOCAL - MongoDB
MONGO_HOST=db-core-mongo
MONGO_PORT=27017
MONGO_DB_NAME=core_catalog
MONGO_INITDB_DATABASE=core_catalog

