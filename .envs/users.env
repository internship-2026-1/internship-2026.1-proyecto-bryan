# LOCAL
USERS_DB_ENGINE=postgresql
USERS_DB_NAME=users_db
USERS_DB_USER=users_user
USERS_DB_PASSWORD=users_pass
USERS_DB_HOST=db-users-pg
USERS_DB_PORT=5432

# Compatibilidad con código legacy
POSTGRES_DB=users_db
POSTGRES_USER=users_user
POSTGRES_PASSWORD=users_pass
POSTGRES_HOST=db-users-pg
POSTGRES_PORT=5432

